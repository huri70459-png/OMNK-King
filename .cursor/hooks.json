{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {"matcher": "Write|Delete", "command": ".cursor/hooks/phase1-guard.ps1", "timeout": 10, "failClosed": true}
    ],
    "beforeShellExecution": [
      {"matcher": ".*", "command": ".cursor/hooks/phase1-guard.ps1", "timeout": 10, "failClosed": true}
    ],
    "beforeMCPExecution": [
      {"matcher": ".*", "command": ".cursor/hooks/phase1-guard.ps1", "timeout": 10, "failClosed": true}
    ],
    "sessionStart": [
      {"command": ".cursor/hooks/phase1-guard.ps1", "timeout": 10}
    ],
    "stop": [
      {"command": ".cursor/hooks/phase1-guard.ps1", "timeout": 10}
    ]
  }
}
